            "heading",
            "summary",
            "update_button",
            "update_label",
            "archive_button",
            "archive_label",
            "delete_button",
            "delete_label",
            "invalid_button",
            "invalid_label",
            "unknown_button",
            "unknown_label"
          ]
        },
        { "id": "eyebrow", "component": "Text", "text": "AGENT RECOMMENDATION", "variant": "caption" },
        { "id": "heading", "component": "Text", "text": { "@path": "/heading" } },
