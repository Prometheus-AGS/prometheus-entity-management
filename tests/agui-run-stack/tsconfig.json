{
  "//": "Static check of the UPG-10/11/12 page only: tsc -p tests/agui-run-stack/tsconfig.json. Types resolve through the built packages (dist declarations) and the package's own React types, as vite.config.mjs resolves the code.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": [],
    "paths": {
      "@prometheus-ags/a2ui-react": ["../../packages/a2ui-react/dist/index.d.ts"],
      "@prometheus-ags/a2ui-react/ag-ui": ["../../packages/a2ui-react/dist/ag-ui.d.ts"],
      "@prometheus-ags/entity-graph-core": ["../../packages/entity-graph-core/dist/index.d.ts"],
      "react": ["../../packages/a2ui-react/node_modules/@types/react/index.d.ts"],
      "react-dom/client": ["../../packages/a2ui-react/node_modules/@types/react-dom/client.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
