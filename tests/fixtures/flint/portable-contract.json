  "realtime": {
    "clientMethods": ["watchEntities", "mutateEntity"],
    "queryFields": ["channelId", "consumerId", "entityType", "fromOffset"],
    "recordFields": ["entityType", "entityId", "tenantId", "channelId", "data", "correlationId"],
    "eventFields": ["entityType", "entityId", "tenantId", "channelId", "data", "offset", "correlationId"],
    "entityChangeKind": 1
  },
  "security": {
    "issuer": {
      "claim": "iss",
      "productionRequired": true
    },
    "tenant": {
      "claim": "tenant_id",
      "requiredUuid": true,
      "publishMustMatchChannel": true,
      "subscribeDropsForeignTenant": true
    },
    "tokenHeader": {
      "asymmetricKidRequired": true,
      "field": "kid"
    },
    "jwks": {
      "path": "/.well-known/jwks.json",
      "rsaStandardMembers": ["n", "e"],
      "pemCompatibilityExtension": true,
      "rsaStrictConsumerCompatible": true,
      "ecStrictConsumerCompatible": false,
      "ecMissingStandardMembers": ["crv", "x", "y"],
      "symmetricKeysPublished": false,
      "unknownKidRefresh": true,
      "ttlSeconds": 300
    },
    "roles": {
      "forwardedRoleHeader": "X-Flint-Role",
      "forwardedTenantHeader": "X-Flint-Tenant-Id",
      "browserRole": "anon",
      "serverRole": "service_role"
    },
    "keySeparation": {
      "publishableKeyEnvironment": "FLINT_ANON_KEY",
      "serverKeyEnvironment": "FLINT_SERVICE_ROLE_KEY",
      "serverKeyPrefix": "flint_sk_",
      "serviceRoleServerOnly": true,
      "browserLikeClientsRejectServerKeys": true
    }
  },
  "provisioning": {
    "basePath": "/schema/v1",
    "routes": ["plan", "apply", "status", "ddl"],
    "enabledByDefault": false,
    "typedJsonOnly": true,
    "rawSqlAccepted": false,
    "planHashRequired": true,
    "namespaceAllowlistRequired": true,
    "serviceRoleOnly": true,
    "singleTransaction": true,
    "enableRls": true,
    "forceRls": true,
    "perVerbTenantPolicies": true,
    "auditLedger": true,
    "restartRequiredForNewRestRoutes": true,
    "prometheusForgeAdapterImplemented": false
  }
}
