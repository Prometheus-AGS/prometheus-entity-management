{
  "//": "Static check of the conformance page only: tsc -p tests/conformance/a2ui/harness/tsconfig.json. Types resolve through the built package (dist declarations) and its own React and Zod, as the Vite config resolves the code.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [],
    "paths": {
      "@prometheus-ags/a2ui-react": ["../../../../packages/a2ui-react/dist/index.d.ts"],
      "react": ["../../../../packages/a2ui-react/node_modules/@types/react/index.d.ts"],
      "react-dom/client": ["../../../../packages/a2ui-react/node_modules/@types/react-dom/client.d.ts"],
      "zod/v3": ["../../../../packages/a2ui-react/node_modules/zod/v3/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
