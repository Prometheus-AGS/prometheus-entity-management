{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometheus-ags.github.io/prometheus-entity-management/schemas/v3-release-contract.schema.json",
  "title": "Prometheus Entity Management 3.x release contract",
  "type": "object",
  "required": ["schemaVersion", "release", "versionPolicy", "registryScope", "artifacts", "compatibility", "moduleContract", "graphContract", "protocols", "securityBoundaries", "releaseGates", "recoveryPolicy", "explicitExclusions"],
  "properties": {
    "schemaVersion": {"const":"1.0.0"},
    "release": {
      "type":"object",
      "required":["version","channel","owner","repository","license"],
      "properties":{
        "name":{"type":"string","minLength":1},
        "version":{"pattern":"^3\\.[0-9]+\\.[0-9]+$"},
        "channel":{"const":"stable"},
        "owner":{"type":"string","minLength":1},
        "repository":{"type":"string","format":"uri"},
        "license":{"type":"string","minLength":1}
      },
      "additionalProperties":false
    },
    "artifacts": {
      "type":"array",
      "minItems":16,
      "maxItems":16,
      "items": {
        "type":"object",
        "required":["id","ecosystem","packageName","path","owner","registry","registryDecision","versionPolicy","stability","role"],
        "properties": {
          "id":{"type":"string","minLength":1},
          "ecosystem":{"enum":["npm","dart","rust"]},
          "packageName":{"type":"string","minLength":1},
          "path":{"type":"string","minLength":1},
          "owner":{"type":"string","minLength":1},
          "registry":{"type":"string","minLength":1},
          "registryDecision":{"enum":["required","deferred","embedded"]},
          "versionPolicy":{"type":"string","minLength":1},
          "stability":{"enum":["stable","experimental","internal"]},
          "role":{"type":"string","minLength":1}
        },
        "additionalProperties":false
      }
    },
    "compatibility": {
      "type":"object",
      "required":["node","pnpm","typescript","react","vite","nextjs","flutter","dart","rust","tauri"],
      "additionalProperties":{"type":"string","minLength":1}
    }
  }
}
