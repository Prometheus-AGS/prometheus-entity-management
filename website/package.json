{
  "name": "@prometheus-ags/entity-management-docs",
  "version": "0.0.3",
  "private": true,
  "description": "Prometheus Entity Management documentation site",
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "typecheck": "tsc --noEmit",
    "typecheck:snippets": "tsc --noEmit -p tsconfig.snippets.json",
    "check:content": "node scripts/check-content.mjs",
    "check:build": "node scripts/check-build.mjs",
    "generate:evidence": "node scripts/generate-evidence.mjs",
    "generate:search": "node scripts/generate-local-search.mjs",
    "generate:api": "node scripts/generate-packed-api.mjs",
    "generate:native-api": "node scripts/generate-native-api.mjs",
    "check:artifacts": "node scripts/check-generated-artifacts.mjs",
    "check:native-api": "node scripts/check-native-api.mjs",
    "verify:native-api": "node scripts/verify-native-api.mjs",
    "audit:deployed": "lhci autorun --config=lighthouserc.cjs",
    "check": "pnpm run typecheck && pnpm run check:content",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@prometheus-ags/entity-graph-core": "workspace:*",
    "@prometheus-ags/prometheus-entity-management": "workspace:*",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@lhci/cli": "0.15.1",
    "@mermaid-js/layout-elk": "0.1.9",
    "@swc/helpers": "0.5.23",
    "@types/node": "22.20.1",
    "mermaid": "11.16.1",
    "sharp": "0.35.0",
    "typedoc": "0.28.20",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || >=26.0.0",
    "pnpm": ">=10.33.0 <12"
  }
}
