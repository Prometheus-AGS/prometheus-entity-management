{
  "name": "@prometheus-ags/entity-graph-solid",
  "version": "3.0.0",
  "description": "SolidJS bindings for @prometheus-ags/entity-graph-core — fine-grained reactive entity and list primitives over the normalized entity graph.",
  "author": "Travis James <travis@prometheus.dev>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "refresh:exports": "pnpm run build && node ../../scripts/refresh-exports-ledger.mjs --pkg solid",
    "verify:skills": "node ../../scripts/verify-skills-exports.mjs --pkg solid"
  },
  "peerDependencies": {
    "@prometheus-ags/entity-graph-core": "workspace:^",
    "solid-js": ">=1.8.0"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": false
    }
  },
  "devDependencies": {
    "@prometheus-ags/entity-graph-core": "workspace:*",
    "solid-js": "^1.9.14",
    "tsup": "8.5.1",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  },
  "keywords": [
    "solid",
    "solidjs",
    "entity-graph",
    "normalized-cache",
    "state-management",
    "reactive",
    "fine-grained-reactivity"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prometheus-ags/prometheus-entity-management.git",
    "directory": "packages/entity-graph-solid"
  },
  "homepage": "https://github.com/prometheus-ags/prometheus-entity-management/tree/main/packages/entity-graph-solid#readme",
  "bugs": {
    "url": "https://github.com/prometheus-ags/prometheus-entity-management/issues"
  },
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || >=26.0.0"
  }
}
