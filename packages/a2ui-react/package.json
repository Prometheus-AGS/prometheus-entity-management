{
  "name": "@prometheus-ags/a2ui-react",
  "version": "3.1.0",
  "description": "A2UI v1.0-RC compatibility for React over the official renderer, with policy-gated entity graph actions and AG-UI 0.0.59 activity support.",
  "author": "Travis James <travis@prometheus.dev>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "ag-ui": [
        "dist/ag-ui.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ag-ui": {
      "import": {
        "types": "./dist/ag-ui.d.ts",
        "default": "./dist/ag-ui.mjs"
      },
      "require": {
        "types": "./dist/ag-ui.d.cts",
        "default": "./dist/ag-ui.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/fix-a2ui-cjs-declarations.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "refresh:exports": "pnpm run build && node ../../scripts/refresh-exports-ledger.mjs --a2ui",
    "verify:skills": "node ../../scripts/verify-skills-exports.mjs --a2ui"
  },
  "peerDependencies": {
    "@ag-ui/core": ">=0.0.59 <0.1.0",
    "@prometheus-ags/entity-graph-core": "workspace:*",
    "react": ">=19.0.0 <20.0.0",
    "react-dom": ">=19.0.0 <20.0.0"
  },
  "peerDependenciesMeta": {
    "@ag-ui/core": {
      "optional": true
    }
  },
  "dependencies": {
    "@a2ui/markdown-it": "0.1.0",
    "@a2ui/react": "0.10.2",
    "@a2ui/web_core": "0.10.5",
    "@prometheus-ags/entity-graph-core": "workspace:*",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@ag-ui/core": "0.0.59",
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "jsdom": "^30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "8.5.1",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  },
  "keywords": [
    "a2ui",
    "a2ui-v0.9.1",
    "a2ui-v1.0-rc",
    "agent-ui",
    "entity-graph",
    "react",
    "normalized-cache",
    "state-management",
    "zustand",
    "ag-ui",
    "policy"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Prometheus-AGS/prometheus-entity-management",
    "directory": "packages/a2ui-react"
  },
  "homepage": "https://github.com/prometheus-ags/prometheus-entity-management/tree/main/packages/a2ui-react#readme",
  "bugs": {
    "url": "https://github.com/prometheus-ags/prometheus-entity-management/issues"
  },
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || >=26.0.0"
  }
}
