{
  "name": "@prometheus-ags/entity-graph-htmx",
  "version": "3.2.0",
  "description": "Node.js SSE fragment server for HTMX — streams HTML entity fragments over Server-Sent Events with idiomorph/morph swaps, backed by the Prometheus entity graph.",
  "author": "Travis James <travis@prometheus.dev>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "refresh:exports": "pnpm run build && node ../../scripts/refresh-exports-ledger.mjs --pkg htmx",
    "verify:skills": "node ../../scripts/verify-skills-exports.mjs --pkg htmx"
  },
  "dependencies": {
    "@prometheus-ags/entity-graph-sdl": "workspace:*"
  },
  "peerDependencies": {
    "@prometheus-ags/entity-graph-core": "workspace:^"
  },
  "devDependencies": {
    "@prometheus-ags/entity-graph-core": "workspace:*",
    "@types/node": "22.20.1",
    "tsup": "8.5.1",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  },
  "keywords": [
    "htmx",
    "sse",
    "server-sent-events",
    "html-fragments",
    "idiomorph",
    "entity-graph",
    "normalized-cache",
    "state-management"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Prometheus-AGS/prometheus-entity-management",
    "directory": "packages/entity-graph-htmx"
  },
  "homepage": "https://github.com/prometheus-ags/prometheus-entity-management/tree/main/packages/entity-graph-htmx#readme",
  "bugs": {
    "url": "https://github.com/prometheus-ags/prometheus-entity-management/issues"
  },
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || >=26.0.0"
  }
}
