{
  "name": "@prometheus-ags/entity-graph-core",
  "version": "3.0.0-rc.1",
  "description": "Framework-agnostic normalized entity graph store (zero React) — the core of the Prometheus entity-graph ecosystem.",
  "author": "Travis James <travis@prometheus.dev>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:flint-live": "vitest run --config vitest.flint-live.config.ts --reporter verbose"
  },
  "peerDependencies": {
    "@ag-ui/core": ">=0.0.30",
    "@tauri-apps/plugin-sql": ">=2.0.0",
    "loro-crdt": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@ag-ui/core": {
      "optional": true
    },
    "@tauri-apps/plugin-sql": {
      "optional": true
    },
    "loro-crdt": {
      "optional": true
    }
  },
  "dependencies": {
    "immer": "^11.1.15",
    "zustand": "^5.0.14"
  },
  "keywords": [
    "entity-graph",
    "normalized-cache",
    "state-management",
    "zustand",
    "framework-agnostic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prometheus-ags/prometheus-entity-management.git",
    "directory": "packages/entity-graph-core"
  },
  "homepage": "https://github.com/prometheus-ags/prometheus-entity-management/tree/main/packages/entity-graph-core#readme",
  "bugs": {
    "url": "https://github.com/prometheus-ags/prometheus-entity-management/issues"
  },
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || >=26.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4"
  }
}
