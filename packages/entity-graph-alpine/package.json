{
  "name": "@prometheus-ags/entity-graph-alpine",
  "version": "3.0.2",
  "description": "Alpine.js plugin exposing $entity(type,id) and $entityList(type,query) magics — wires @prometheus-ags/entity-graph-core into Alpine.effect().",
  "author": "Travis James <travis@prometheus.dev>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "refresh:exports": "pnpm run build && node ../../scripts/refresh-exports-ledger.mjs --pkg alpine",
    "verify:skills": "node ../../scripts/verify-skills-exports.mjs --pkg alpine"
  },
  "peerDependencies": {
    "@prometheus-ags/entity-graph-core": "workspace:^",
    "alpinejs": ">=3.13.0"
  },
  "peerDependenciesMeta": {
    "alpinejs": {
      "optional": false
    }
  },
  "devDependencies": {
    "@prometheus-ags/entity-graph-core": "workspace:*",
    "alpinejs": "^3.15.12",
    "tsup": "8.5.1",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  },
  "keywords": [
    "alpine",
    "alpinejs",
    "entity-graph",
    "normalized-cache",
    "state-management",
    "zustand",
    "magic"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Prometheus-AGS/prometheus-entity-management",
    "directory": "packages/entity-graph-alpine"
  },
  "homepage": "https://github.com/prometheus-ags/prometheus-entity-management/tree/main/packages/entity-graph-alpine#readme",
  "bugs": {
    "url": "https://github.com/prometheus-ags/prometheus-entity-management/issues"
  },
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || >=26.0.0"
  }
}
