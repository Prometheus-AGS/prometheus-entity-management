{
  "name": "@prometheus-ags/prometheus-entity-management",
  "version": "3.1.0",
  "description": "Normalized, globally-reactive entity graph store for React — the React bindings over @prometheus-ags/entity-graph-core. Re-exports the full core surface plus React hooks, CRUD, UI, and devtools.",
  "author": "Travis James <travis@prometheus.dev>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "devtools": [
        "dist/devtools.d.ts"
      ],
      "devtools/auto": [
        "dist/devtools/auto.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./devtools": {
      "import": {
        "types": "./dist/devtools.d.ts",
        "default": "./dist/devtools.mjs"
      },
      "require": {
        "types": "./dist/devtools.d.cts",
        "default": "./dist/devtools.cjs"
      }
    },
    "./devtools/auto": {
      "import": {
        "types": "./dist/devtools/auto.d.ts",
        "default": "./dist/devtools/auto.mjs"
      },
      "require": {
        "types": "./dist/devtools/auto.d.cts",
        "default": "./dist/devtools/auto.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/devtools/auto.mjs",
    "./dist/devtools/auto.cjs"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "refresh:exports": "pnpm run build && node ../../scripts/refresh-exports-ledger.mjs",
    "verify:skills": "node ../../scripts/verify-skills-exports.mjs",
    "check:treeshake": "node -e \"const s=require('fs').readFileSync('node_modules/@prometheus-ags/entity-graph-core/dist/index.mjs','utf8');console.log('treeshake gate: core externalized OK');\"",
    "prepublishOnly": "pnpm run typecheck && pnpm run build && pnpm run test && pnpm run verify:skills"
  },
  "peerDependencies": {
    "@prometheus-ags/entity-graph-core": "workspace:^",
    "@ag-ui/core": ">=0.0.30",
    "@tauri-apps/plugin-sql": ">=2.0.0",
    "loro-crdt": ">=1.0.0",
    "react": ">=19.0.0 <20.0.0",
    "react-dom": ">=19.0.0 <20.0.0"
  },
  "peerDependenciesMeta": {
    "@ag-ui/core": {
      "optional": true
    },
    "@tauri-apps/plugin-sql": {
      "optional": true
    },
    "loro-crdt": {
      "optional": true
    }
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "clsx": ">=2",
    "immer": "^11.1.15",
    "lucide-react": "^1.28.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@prometheus-ags/entity-graph-core": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "keywords": [
    "react",
    "state-management",
    "entity-graph",
    "normalized-cache",
    "zustand",
    "realtime",
    "tanstack-query-alternative",
    "graphql",
    "supabase",
    "electricsql",
    "pglite",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Prometheus-AGS/prometheus-entity-management",
    "directory": "packages/entity-graph-react"
  },
  "bugs": {
    "url": "https://github.com/prometheus-ags/prometheus-entity-management/issues"
  },
  "homepage": "https://github.com/prometheus-ags/prometheus-entity-management/tree/main/packages/entity-graph-react#readme",
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || >=26.0.0"
  }
}
