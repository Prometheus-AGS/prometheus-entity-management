{
  "name": "@prometheus-ags/entity-graph-sync",
  "version": "3.0.0-rc.2",
  "description": "Pluggable peer-sync providers for the entity graph — ships Yjs (WebSocket + WebRTC) and Loro CRDT providers that bridge the core entity graph with collaborative editing engines.",
  "author": "Travis James <travis@prometheus.dev>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:websocket-integration": "vitest run src/providers/loro-websocket.integration.test.ts",
    "refresh:exports": "pnpm run build && node ../../scripts/refresh-exports-ledger.mjs --sync",
    "verify:skills": "node ../../scripts/verify-skills-exports.mjs --sync"
  },
  "dependencies": {
    "@prometheus-ags/entity-graph-core": "workspace:*"
  },
  "peerDependencies": {
    "loro-crdt": ">=1.13.9 <2",
    "y-webrtc": ">=10.2.3",
    "y-websocket": ">=2.0.4",
    "yjs": ">=13.6.0"
  },
  "peerDependenciesMeta": {
    "loro-crdt": {
      "optional": true
    },
    "y-webrtc": {
      "optional": true
    },
    "y-websocket": {
      "optional": true
    },
    "yjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "loro-crdt": "1.13.9",
    "tsup": "8.5.1",
    "typescript": "6.0.2",
    "vitest": "4.1.10",
    "ws": "8.21.1"
  },
  "keywords": [
    "entity-graph",
    "sync",
    "crdt",
    "yjs",
    "loro",
    "collaboration",
    "peer-sync",
    "websocket",
    "webrtc"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prometheus-ags/prometheus-entity-management.git",
    "directory": "packages/entity-graph-sync"
  },
  "homepage": "https://github.com/prometheus-ags/prometheus-entity-management/tree/main/packages/entity-graph-sync#readme",
  "bugs": {
    "url": "https://github.com/prometheus-ags/prometheus-entity-management/issues"
  },
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || >=26.0.0"
  }
}
