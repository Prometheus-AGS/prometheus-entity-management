{
  "name": "@prometheus-ags/entity-graph-web-components",
  "version": "3.0.2",
  "description": "Lit 3 custom elements (<entity-list>, <entity-detail>, <entity-form>) using ReactiveController to subscribe to the core entity graph. Framework-agnostic.",
  "author": "Travis James <travis@prometheus.dev>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-web-components-package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "refresh:exports": "pnpm run build && node ../../scripts/refresh-exports-ledger.mjs --pkg web-components",
    "verify:skills": "node ../../scripts/verify-skills-exports.mjs --pkg web-components"
  },
  "peerDependencies": {
    "@prometheus-ags/entity-graph-core": "workspace:^",
    "lit": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": false
    }
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@prometheus-ags/entity-graph-core": "workspace:*",
    "tsup": "8.5.1",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  },
  "keywords": [
    "web-components",
    "lit",
    "lit3",
    "custom-elements",
    "entity-graph",
    "normalized-cache",
    "state-management",
    "zustand",
    "framework-agnostic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prometheus-ags/prometheus-entity-management.git",
    "directory": "packages/entity-graph-web-components"
  },
  "homepage": "https://github.com/prometheus-ags/prometheus-entity-management/tree/main/packages/entity-graph-web-components#readme",
  "bugs": {
    "url": "https://github.com/prometheus-ags/prometheus-entity-management/issues"
  },
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || >=26.0.0"
  }
}
